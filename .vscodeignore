# What stays out of the .vsix. The rule of thumb: the package carries what the
# extension host actually loads at run time, and nothing that only the build
# needs. `vsce` already drops devDependencies from node_modules on its own, so
# what is listed here is the repository's own build-time material.

# TypeScript sources and their build configuration. `out/` and `media/` hold
# the emitted JavaScript, which is what `main` and the webview load.
#
# bin/ is deliberately absent from this list: a platform-specific package is
# built with lhatls in it, and src/bundled.ts looks for it there.
src/**
tsconfig.json
tsconfig.rf.json
tsconfig.webview.json

# Source maps point back at src/, which is not shipped. The F5 extension
# development host runs straight from the working tree and keeps its maps
# either way, so debugging is unaffected.
**/*.map

# `out/extension.js` is bundled from the extension's entry point. The other
# TypeScript output files are only its source modules, and shipping them would
# duplicate both code and files already contained in that bundle.
out/**
!out/extension.js

# Editor and repository plumbing.
.vscode/**
.github/**
.gitignore
.vscodeignore
package-lock.json

devdocs/**

# Which lhat release the packages bundle -- read by the release workflow,
# of no use to anyone who has already installed one.
.lhat-version

# Sample sources for driving the extension by hand (README's "testing").
# The extension does not read them; they are for whoever is working on it.
testing/**
scripts/**

# Earlier packages, when one is built in place.
*.vsix
