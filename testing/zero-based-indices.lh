# Run with the runtime built from lhat 5529b14 or later.
# A missing slot often just returns nil^, so check values as well as types.
import^std.regex

let^expect = p^condition:bool^, label:string^ {
    if^!condition { panic^label }
}

let^values = { 10, 20, 30 }
expect(values.length^ = 3 and^values.0 = 10 and^values[2] = 30, "table positions")
expect(values[values.length^ - 1] = 30 and^values[values.length^] = nil^, "table boundaries")
# Bracket access reads a key; only ordinal-taking operations resolve negatives.
expect(values[-1] = nil^ and^values.slice^(-1)[0] = 30, "negative key and ordinal")
let^nested = { { 42 } }
expect(nested.0.0 = 42, "chained numeric members")

let^dense:t^{number^[]} = {}
for^i from^0 to^values.length^ - 1 { dense[i] := values[i] ?? -1 }
var^sum = 0
for^value in^dense { sum += value }
expect(dense.length^ = 3 and^sum = 60, "dense sequence and value iteration")
var^reverse = ""
for^i from^dense.length^ - 1 downto^0 { reverse := reverse .. (dense[i] ?? -1).tostring() }
expect(reverse = "302010", "inclusive descending range")

let^part = values.slice^(1, 2)
expect(part.length^ = 2 and^part[0] = 20 and^part[1] = 30, "inclusive slice")
dense.insert^(0, 5)
dense.insert^(dense.length^, 40)
expect(dense.length^ = 5 and^dense[0] = 5 and^dense[dense.length^ - 1] = 40, "insert positions")
expect(dense.remove^(-1) = 40 and^dense.remove^(0) = 5, "remove positions")
expect(dense.indexof^(10) = 0 and^dense.indexof^(30) = 2, "indexof ordinals")

let^text = "あいうあ"
expect(text.at(0) = "あ" and^text.at(-1) = "あ", "character ordinals")
expect(text.substr(1, 2) = "いう" and^text.substr(0, -1) = text, "inclusive substring")
expect(text.find("あ") = 0 and^text.find("あ", 1) = 3, "find ordinals")
let^positions:t^{number^[]} = {}
for^i in^text.findall("あ") { positions.push^(i) }
expect(positions.length^ = 2 and^positions[0] = 0 and^positions[1] = 3, "findall ordinals")
let^pieces = "a,b,c".split(",")
expect(pieces.length^ = 3 and^pieces[0] = "a" and^pieces[pieces.length^ - 1] = "c", "split positions")

let^pair = f^{ (7, "eight") }
let^packed = pack^pair()
expect(packed.length^ = 2 and^packed[0] = 7 and^packed[1] = "eight", "packed positions")
let^first = f^...:number^ { ...[0] }
expect(first(11, 22) = 11, "variadic positions")
enum^Mode { Idle, Walk, Explicit = 10, Next }
expect(Mode.Idle.value = 0 and^Mode.Walk.value = 1 and^Mode.Next.value = 11, "enum numbering")

with^regex = try^std.regex.new("(a)(b)") {
    let^caps = regex.captures("ab")
    if^caps? {
        expect(caps[0] = "ab" and^caps[1] = "a" and^caps[2] = "b", "capture group numbers")
    else^:
        panic^"missing captures"
    }
    let^replaced = regex.gsub("abxab", f^match, at, caps {
        return^ (caps[0] ?? "?") .. ":" .. (caps[1] ?? "?") .. ":" .. at.tostring()
    })
    expect(replaced = "ab:a:0xab:a:3", "replacement capture numbers and ordinals")
    let^starts:t^{number^[]} = {}
    for^i, match in^regex.gmatch("abxab") { starts.push^(i) }
    expect(starts.length^ = 2 and^starts[0] = 0 and^starts[1] = 3, "gmatch ordinals")
}

print("zero-based indices: OK")
