module^examples.literals

# Literal inputs update the unsaved document on Enter or blur.
let^amount = -3.5
let^message = "  Hello, 世界  "
let^precise = 1234567890123456789
let^hex = 0xFF
let^empty = ""
let^multiline = "first\nsecond"
let^raw = 'C:\temp\file.txt'

let^values = { 10, 15, 1_000, 2.5e-3, "sample" }
let^nested = def^{ count = 42, read = f^{ "inside" } }
enum^Mode { Idle, Label = "ready", Code = 7 }
errordef^Problem { Missing { name = "", code = 404 } }

# Expressions and interpolation expose their own editing controls.
let^expression = 1 + 2
let^interpolation = $"amount: {amount}"
